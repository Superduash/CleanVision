# ── Flask Backend ──────────────────────────────────────────────────────────────
# Leave empty in local dev (Vite proxy handles /api/* → localhost:5000).
# In production set this to your deployed Render URL.
VITE_API_BASE_URL=

# ── Firebase ────────────────────────────────────────────────────────────────────
# Copy these from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Support & Sales Contact Emails ──────────────────────────────────────────────
VITE_SUPPORT_EMAIL=support@cleanvision.com
VITE_SALES_EMAIL=sales@cleanvision.com
