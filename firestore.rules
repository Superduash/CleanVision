rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isStaff() {
      return isAuthenticated() && (getUserRole() in ['admin', 'manager', 'inspector']);
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Singleton Hospital Configuration — public read
    match /hospitalConfig/main {
      allow read: if true;
      allow write: if false; // Only backend service account writes
    }

    // Public Room Lookup — public read
    match /roomLookup/{roomCode} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public Unauthenticated Visitor Issue Reports — public create allowed only for valid room codes
    match /issueReports/{reportId} {
      allow create: if request.resource.data.roomCode != null &&
                      exists(/databases/$(database)/documents/roomLookup/$(request.resource.data.roomCode));
      allow read, update: if isStaff() && (
        getUserRole() in ['admin', 'manager'] ||
        (getUserRole() == 'inspector' && (
          request.auth.token.assignedBlocks == null ||
          request.auth.token.assignedBlocks.size() == 0 ||
          request.auth.token.assignedBlocks.hasAny([resource.data.block])
        ))
      );
      allow delete: if isAuthenticated() && (getUserRole() in ['admin', 'manager']);
    }

    // Staff Users — readable by staff; writable ONLY by backend service account
    match /users/{userId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Rooms, Scans & Notifications
    match /rooms/{roomId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /scans/{scanId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
